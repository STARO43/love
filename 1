<!doctype html>
<html lang="ru" data-theme="auto">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy"
      content="default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'">
<title>/0</title>
<style>
  :root{
    --bg:#f6f1e7;
    --text:#2b2620;
    --muted:#8a8172;
    --line:#e2d9c6;
    --panel:#fbf7ee;
    --accent:#2b2620;
    --overlay:rgba(43,38,32,.32);
    --shadow:0 20px 44px -20px rgba(60,45,20,.28);
    --view:#2b2620;
  }
  [data-theme="dark"]{
    --bg:#14120f;
    --bg-2:#181510;
    --text:#d8cfc1;
    --muted:#8a8074;
    --line:#2a2620;
    --panel:#1b1813;
    --accent:#d8cfc1;
    --overlay:rgba(0,0,0,.62);
    --shadow:0 22px 50px -22px rgba(0,0,0,.75);
    --view:#f0eae0;
  }
  @media (prefers-color-scheme: dark){
    [data-theme="auto"]{
      --bg:#14120f;
      --bg-2:#181510;
      --text:#d8cfc1;
      --muted:#8a8074;
      --line:#2a2620;
      --panel:#1b1813;
      --accent:#d8cfc1;
      --overlay:rgba(0,0,0,.62);
      --shadow:0 22px 50px -22px rgba(0,0,0,.75);
      --view:#f0eae0;
    }
  }
  *{box-sizing:border-box}
  html{height:100%}
  body{
    margin:0;
    min-height:100vh;
    background:
      radial-gradient(1200px 700px at 50% -10%, var(--bg-2), transparent 60%),
      var(--bg);
    background-attachment:fixed;
    background-repeat:no-repeat;
    background-size:cover;
    color:var(--text);
    font-family:Georgia,"Times New Roman",serif;
    -webkit-font-smoothing:antialiased;
    transition:background-color .3s ease, color .3s ease;
    overflow-y:auto;
  }
  .wrap{
    max-width:680px; margin:0 auto;
    padding:46px 30px 120px;
    position:relative;
    min-height:100vh;
    display:flex;
    flex-direction:column;
  }

  .bar{
    display:flex; align-items:center; justify-content:space-between;
    gap:20px; margin-bottom:26px;
    font-size:15px; color:var(--muted);
    user-select:none;
    padding-bottom:16px;
    border-bottom:1px solid var(--line);
    position:relative;
    z-index:30;
    flex:0 0 auto;
  }
  .bar-left{
    display:flex; align-items:center; gap:14px;
  }

  .sizer{
    display:flex; align-items:center; gap:2px;
  }
  .sizer button{
    appearance:none; border:0; background:transparent;
    color:var(--muted); font:inherit;
    font-size:26px; line-height:1;
    width:30px; height:32px;
    display:grid; place-items:center;
    padding:0; cursor:default;
  }
  .sizer button:focus{outline:none}

  .fontwrap{
    position:relative;
    display:inline-flex; align-items:center;
  }
  .fontwrap .glyph{
    color:var(--muted);
    font-family:Georgia,"Times New Roman",serif;
    font-size:22px; line-height:1;
    user-select:none;
    padding:0;
    background:none;
    border:0;
    cursor:default;
    -webkit-tap-highlight-color:transparent;
  }
  .fontwrap .glyph:focus{outline:none}
  .fontwrap .glyph::selection{background:transparent}

.view{
  appearance:none; border:0;
  background:var(--muted);
  color:var(--bg);
  padding:2px 6px;
  border-radius:4px;
  cursor:default;
  font-family:Georgia,"Times New Roman",serif;
  font-size:22px; 
  line-height:1.2;
  letter-spacing:-.02em;
  margin-left:10px;
  -webkit-tap-highlight-color:transparent;
}
.view:focus{outline:none}

 .fontmenu{
  position:absolute; top:calc(100% + 12px); left:-14px;
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:10px;
  box-shadow:var(--shadow);
  padding:6px;
  display:none;
  z-index:100;
  font-family:Georgia,"Times New Roman",serif;
  white-space:nowrap;
  width:max-content;
}
  .fontmenu.open{display:block}
  .fontmenu button{
  display:flex; align-items:baseline; justify-content:flex-start;
  width:100%;
  appearance:none; border:0; background:transparent;
  color:var(--text); font:inherit; font-size:15px;
  padding:8px 12px;
  border-radius:6px;
  cursor:default;
  text-align:left;
  -webkit-tap-highlight-color:transparent;
}
  .fontmenu button:hover{background:rgba(127,127,127,.12)}
  .fontmenu button.active{color:var(--accent); font-weight:700}


  .editor{
    width:100%;
    flex:1 1 auto;
    min-height:60vh;
    border:0; outline:none; resize:none;
    background:transparent; color:var(--text);
    font:inherit; line-height:1.75;
    padding:0;
    letter-spacing:.005em;
    overflow:hidden;
    position:relative;
    z-index:1;
  }
  .editor::placeholder{color:var(--muted); font-style:italic; opacity:.7}

  .foot{
    display:flex; align-items:center; justify-content:flex-end;
    margin-top:44px;
    flex:0 0 auto;
  }
  .foot .convert{
    appearance:none; border:0; background:transparent;
    color:var(--muted); font:inherit;
    font-size:34px; line-height:1;
    padding:6px 10px; cursor:default;
    font-family:Georgia,"Times New Roman",serif;
    font-weight:400;
    -webkit-tap-highlight-color:transparent;
  }
  .foot .convert:focus{outline:none}

  .overlay{
    position:fixed; inset:0; background:var(--overlay);
    display:none; align-items:center; justify-content:center;
    padding:20px; z-index:50;
    backdrop-filter:blur(2px);
  }
  .overlay.open{display:flex}
  .modal{
    position:relative;
    background:var(--panel); color:var(--text);
    border-radius:12px; padding:34px 28px 26px;
    width:100%; max-width:420px;
    box-shadow:var(--shadow);
    border:1px solid var(--line);
    font-family:Georgia,"Times New Roman",serif;
  }
  .closex{
    position:absolute; top:8px; right:12px;
    appearance:none; border:0; background:transparent;
    color:var(--muted); font-size:20px; line-height:1;
    padding:4px 6px; cursor:default;
    font-family:Georgia,"Times New Roman",serif;
    -webkit-tap-highlight-color:transparent;
  }
  .closex:focus{outline:none}

  .passrow{
    display:grid;
    grid-template-columns:60px 1fr 60px;
    gap:10px; align-items:stretch;
  }
  .passrow .pw{
    width:100%; padding:14px 16px; font-size:18px;
    background:transparent; color:inherit;
    border:1px solid var(--line); border-radius:8px; outline:none;
    font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
    letter-spacing:.22em; text-align:center;
    -webkit-text-security:disc;
  }
  .passrow .pw:focus{border-color:var(--text)}
  .passrow .pw::placeholder{color:var(--muted); letter-spacing:normal; font-family:inherit; font-size:14px}

  .passrow .act{
    appearance:none; cursor:default; font:inherit; font-size:20px; font-weight:700;
    border:1px solid var(--line); background:transparent; color:var(--text);
    border-radius:8px;
    -webkit-tap-highlight-color:transparent;
  }
  .passrow .act:hover{border-color:var(--text)}
  .passrow .act[disabled]{opacity:.4}
  .passrow .act.pack{background:var(--accent); color:var(--bg); border-color:var(--accent)}
  .passrow .act.pack:hover{opacity:.85}

  .modal-status{
    margin-top:16px; font-size:13px; color:var(--muted); min-height:18px;
    text-align:center;
  }
  .modal-status.err{color:#a8442f}
  .modal-status.ok{color:#4a7a3a}

  .lang{
  appearance:none; border:0; background:transparent;
  color:var(--muted); font-family:Georgia,"Times New Roman",serif;
  font-size:22px; line-height:1; letter-spacing:-.02em;
  padding:0; cursor:default; margin-left:6px;
  display:inline-flex; align-items:center; justify-content:center;
  transform: translateY(1px);
  -webkit-tap-highlight-color:transparent;
}
.lang:focus{outline:none}
</style>
</head>
<body>
<div class="wrap">

  <div class="bar">
    <div class="bar-left">
      <div class="sizer">
        <button id="dec" aria-label="Меньше">−</button>
        <button id="inc" aria-label="Больше">+</button>
      </div>
      <div class="fontwrap" id="fontwrap">
        <button type="button" class="glyph" id="fontGlyph" aria-label="Шрифт">𝓐𝕒</button>
        <div class="fontmenu" id="fontMenu" role="menu" aria-label="Шрифт"></div>
          <button class="view" id="view" aria-label="Тема">𝓐𝕒</button>
           </div>
    </div>
         <button class="lang" id="lang">𝓔𝓝</button>

  </div>

  <textarea class="editor" id="editor" placeholder="Ввод..." spellcheck="false"></textarea>

  <div class="foot">
    <button class="convert" id="go" aria-label="Преобразовать">#</button>
  </div>
</div>

<div class="overlay" id="overlay">
  <div class="modal" role="dialog" aria-modal="true">
    <button class="closex" id="modalClose" aria-label="Закрыть">×</button>
    <div class="passrow">
    <button class="act" id="btnUnpack" title="Распаковать">↶</button>
      <input class="pw" id="pw" type="text" maxlength="10" placeholder="••••••••••" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" name="nope-please-ignore" aria-label="Поле">
      <button class="act pack" id="btnPack" title="Упаковать">→</button>
    </div>
    <div class="modal-status" id="modalStatus" aria-live="polite"></div>
  </div>
</div>

<script>
(() => {
  'use strict';

  const A = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_';
  const L = (() => { const m = Object.create(null); for (let i = 0; i < A.length; i++) m[A[i]] = i; return m; })();

  const HASH_LIMIT = 24000;

  const wf = (v) => {
    const s = String(v ?? '');
    if (typeof s.toWellFormed === 'function') return s.toWellFormed();
    let o = '';
    for (let i = 0; i < s.length; i++) {
      const c = s.charCodeAt(i);
      if (c >= 0xd800 && c <= 0xdbff) {
        const n = s.charCodeAt(i + 1);
        if (n >= 0xdc00 && n <= 0xdfff) { o += s[i] + s[i + 1]; i++; }
        else o += '\uFFFD';
      } else if (c >= 0xdc00 && c <= 0xdfff) o += '\uFFFD';
      else o += s[i];
    }
    return o;
  };

  const zc = (input) => {
    const s = wf(input);
    if (!s) return '';
    const d = Object.create(null);
    const tc = Object.create(null);
    let ds = 3, nb = 2, ei = 2, w = '';
    const st = { out: [], v: 0, p: 0 };
    const em = (bit) => {
      st.v = (st.v << 1) | bit;
      if (st.p === 5) { st.out.push(A[st.v]); st.v = 0; st.p = 0; }
      else st.p++;
    };
    const fl = () => {
      if (w in tc) {
        if (w.charCodeAt(0) < 256) {
          for (let k = 0; k < nb; k++) em(0);
          let v = w.charCodeAt(0);
          for (let k = 0; k < 8; k++) { em(v & 1); v >>= 1; }
        } else {
          let v = 1;
          for (let k = 0; k < nb; k++) { em(v & 1); v >>= 1; }
          let vv = w.charCodeAt(0);
          for (let k = 0; k < 16; k++) { em(vv & 1); vv >>= 1; }
        }
        ei--;
        if (ei === 0) { ei = 2 ** nb; nb++; }
        delete tc[w];
      } else {
        let v = d[w];
        for (let k = 0; k < nb; k++) { em(v & 1); v >>= 1; }
      }
      ei--;
      if (ei === 0) { ei = 2 ** nb; nb++; }
    };
    for (let i = 0; i < s.length; i++) {
      const c = s.charAt(i);
      if (!(c in d)) { d[c] = ds++; tc[c] = true; }
      const wc = w + c;
      if (wc in d) { w = wc; continue; }
      fl();
      d[wc] = ds++;
      w = String(c);
    }
    if (w !== '') fl();
    let v = 2;
    for (let k = 0; k < nb; k++) { em(v & 1); v >>= 1; }
    while (true) {
      st.v <<= 1;
      if (st.p === 5) { st.out.push(A[st.v]); break; }
      st.p++;
    }
    return st.out.join('');
  };

  const rb = (n, data, len, get) => {
    let bits = 0, power = 1;
    const max = 2 ** n;
    while (power !== max) {
      const resb = data.val & data.pos;
      data.pos >>= 1;
      if (data.pos === 0) {
        data.pos = 32;
        if (data.i < len) data.val = get(data.i);
        data.i++;
      }
      bits |= (resb > 0 ? 1 : 0) * power;
      power <<= 1;
    }
    return bits;
  };

  const zd = (input) => {
    if (input == null) return null;
    if (input === '') return '';
    const get = (i) => L[input.charAt(i)];
    const data = { val: get(0), pos: 32, i: 1 };
    if (data.val == null) return null;
    const d = [0, 1, 2];
    let ei = 4, ds = 4, nb = 3, en = '';
    const res = [];
    const next = rb(2, data, input.length, get);
    let c;
    if (next === 0) c = String.fromCharCode(rb(8, data, input.length, get));
    else if (next === 1) c = String.fromCharCode(rb(16, data, input.length, get));
    else if (next === 2) return '';
    else return null;
    d[3] = c;
    let w = c;
    res.push(c);
    while (true) {
      if (data.i > input.length) return null;
      let bits = rb(nb, data, input.length, get);
      if (bits === 0) {
        d[ds] = String.fromCharCode(rb(8, data, input.length, get));
        bits = ds++; ei--;
      } else if (bits === 1) {
        d[ds] = String.fromCharCode(rb(16, data, input.length, get));
        bits = ds++; ei--;
      } else if (bits === 2) {
        return res.join('');
      }
      if (ei === 0) { ei = 2 ** nb; nb++; }
      if (d[bits] !== undefined) en = d[bits];
      else if (bits === ds) en = w + w.charAt(0);
      else return null;
      res.push(en);
      d[ds++] = w + en.charAt(0);
      ei--; w = en;
      if (ei === 0) { ei = 2 ** nb; nb++; }
    }
  };

  const te = new TextEncoder();
  const td = new TextDecoder();

  const u8b = (bytes) => {
    let bin = '';
    const CH = 0x8000;
    for (let i = 0; i < bytes.length; i += CH) {
      bin += String.fromCharCode.apply(null, bytes.subarray(i, i + CH));
    }
    return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/g, '');
  };
  const bu8 = (s) => {
    s = String(s || '').replace(/-/g, '+').replace(/_/g, '/');
    while (s.length % 4) s += '=';
    const bin = atob(s);
    const out = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
    return out;
  };

  const dk = async (pw, salt) => {
    const km = await crypto.subtle.importKey('raw', te.encode(pw), 'PBKDF2', false, ['deriveKey']);
    return crypto.subtle.deriveKey(
      { name: 'PBKDF2', salt, iterations: 200000, hash: 'SHA-256' },
      km, { name: 'AES-GCM', length: 256 }, false, ['encrypt', 'decrypt']
    );
  };

  const ep = async (text, pw) => {
    const z = zc(text);
    if (!z) return '';
    const data = te.encode(z);
    const salt = crypto.getRandomValues(new Uint8Array(16));
    const iv = crypto.getRandomValues(new Uint8Array(12));
    const key = await dk(pw, salt);
    const ct = new Uint8Array(await crypto.subtle.encrypt({ name: 'AES-GCM', iv }, key, data));
    const out = new Uint8Array(1 + 16 + 12 + ct.length);
    out[0] = 1;
    out.set(salt, 1);
    out.set(iv, 17);
    out.set(ct, 29);
    return u8b(out);
  };

  const dp = async (hash, pw) => {
    try {
      const raw = bu8(String(hash || '').trim());
      if (raw.length < 1 + 16 + 12 + 16) return null;
      if (raw[0] !== 1) return null;
      const salt = raw.slice(1, 17);
      const iv = raw.slice(17, 29);
      const ct = raw.slice(29);
      const key = await dk(pw, salt);
      const pt = await crypto.subtle.decrypt({ name: 'AES-GCM', iv }, key, ct);
      return zd(td.decode(pt));
    } catch { return null; }
  };

  const $ = (id) => document.getElementById(id);
  const root = document.documentElement;
  const editor = $('editor');
  const overlay = $('overlay');
  const pwInput = $('pw');
  const modalStatus = $('modalStatus');
  const btnPack = $('btnPack');
  const btnUnpack = $('btnUnpack');
  const view = $('view');
  const fontwrap = $('fontwrap');
  const fontMenu = $('fontMenu');
  const fontGlyph = $('fontGlyph');
  const langBtn = $('lang');

  const FONTS = [
    { name: 'Временной',        enName: 'Times',         stack: "'Times New Roman', Times, serif" },
    { name: 'Антенный',        enName: 'Arial',         stack: "Arial, Helvetica, sans-serif" },
    { name: 'Грузинский',      enName: 'Georgia',       stack: "Georgia, 'Times New Roman', serif" },
    { name: 'Старокнижный', enName: 'Antiqua',      stack: "'Book Antiqua', Palatino, serif" },
    { name: 'Баскервильский',  enName: 'Baskerville',   stack: "'Baskerville', 'Libre Baskerville', Georgia, serif" },
    { name: 'Швейцарский',    enName: 'Helvetica',     stack: "'Helvetica Neue', Helvetica, Arial, sans-serif" },
    { name: 'Курьерский',      enName: 'Courier',       stack: "'Courier New', Courier, monospace" },
    { name: 'Моноширинный',         enName: 'Monospace',     stack: "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" },
    { name: 'Верданский',      enName: 'Verdana',       stack: "'Verdana', Geneva, sans-serif" }
  ];

  let isEN = false;

  const i18n = {
    ru: {
      title: 'Скрижа',
      placeholder: 'Ввод...',
      packTitle: 'Упаковать',
      unpackTitle: 'Распаковать',
      errEmpty: 'Пусто',
      errLen: '10 символов',
      errLong: 'Сократите текст',
      errFail: 'Нет',
      errError: 'Ошибка'
    },
    en: {
      title: 'Tablet',
      placeholder: 'Input...',
      packTitle: 'Pack',
      unpackTitle: 'Unpack',
      errEmpty: 'Empty',
      errLen: '10 characters',
      errLong: 'Shorten text',
      errFail: 'None',
      errError: 'Error'
    }
  };

  const applyLang = (lang) => {
    const t = i18n[lang];
    isEN = (lang === 'en');
    document.title = t.title;
    editor.placeholder = t.placeholder;
    btnPack.title = t.packTitle;
    btnUnpack.title = t.unpackTitle;
    langBtn.textContent = isEN ? '𝓅𝓎' : '𝓁𝓃';
    
    fontMenu.querySelectorAll('button').forEach(b => {
      const f = FONTS.find(x => x.stack === b.dataset.stack);
      if (f) b.textContent = isEN ? f.enName : f.name;
    });
    setModalStatus('');
  };

  langBtn.addEventListener('click', () => {
    applyLang(isEN ? 'ru' : 'en');
  });

  const FONT_KEY = 'pack-font-2';
  let currentFont = FONTS[0].stack;
  try {
    const saved = localStorage.getItem(FONT_KEY);
    if (saved) { const f = FONTS.find(x => x.stack === saved); if (f) currentFont = f.stack; }
  } catch {}

  const applyFont = (stack) => {
    currentFont = stack;
    editor.style.fontFamily = stack;
    try { localStorage.setItem(FONT_KEY, stack); } catch {}
    fontMenu.querySelectorAll('button').forEach(b => b.classList.toggle('active', b.dataset.stack === stack));
  };

  FONTS.forEach(f => {
    const b = document.createElement('button');
    b.type = 'button';
    b.dataset.stack = f.stack;
    b.style.fontFamily = f.stack;
    b.textContent = f.name;
    if (f.stack === currentFont) b.classList.add('active');
    b.addEventListener('click', (e) => { e.stopPropagation(); applyFont(f.stack); closeMenu(); });
    fontMenu.appendChild(b);
  });
  applyFont(currentFont);

  const openMenu = () => { fontMenu.classList.add('open'); fontwrap.classList.add('open'); };
  const closeMenu = () => { fontMenu.classList.remove('open'); fontwrap.classList.remove('open'); };
  const toggleMenu = () => { if (fontMenu.classList.contains('open')) closeMenu(); else openMenu(); };

  fontGlyph.addEventListener('click', (e) => { e.stopPropagation(); toggleMenu(); });
  document.addEventListener('click', (e) => { if (!fontwrap.contains(e.target)) closeMenu(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMenu(); });

  const THEME_KEY = 'pack-theme';
  try {
    const t = localStorage.getItem(THEME_KEY);
    if (t === 'light' || t === 'dark') root.setAttribute('data-theme', t);
  } catch {}

  const systemDark = () => matchMedia('(prefers-color-scheme: dark)').matches;
  const currentTheme = () => {
    const t = root.getAttribute('data-theme');
    if (t === 'light' || t === 'dark') return t;
    return systemDark() ? 'dark' : 'light';
  };

  view.addEventListener('click', () => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem(THEME_KEY, next); } catch {}
  });

  const SIZE_KEY = 'pack-size';
  let fontSize = 21;
  try {
    const v = parseInt(localStorage.getItem(SIZE_KEY) || '', 10);
    if (v >= 14 && v <= 38) fontSize = v;
  } catch {}
  const applySize = () => {
    editor.style.fontSize = fontSize + 'px';
    try { localStorage.setItem(SIZE_KEY, String(fontSize)); } catch {}
  };
  applySize();
  $('dec').addEventListener('click', () => { if (fontSize > 14) { fontSize -= 2; applySize(); } });
  $('inc').addEventListener('click', () => { if (fontSize < 38) { fontSize += 2; applySize(); } });

  const grow = () => {
    editor.style.height = 'auto';
    const min = Math.max(window.innerHeight * 0.6, 200);
    editor.style.height = Math.max(editor.scrollHeight, min) + 'px';
  };
  editor.addEventListener('input', grow);
  window.addEventListener('resize', grow);
  grow();

  const setModalStatus = (msg, kind) => {
    modalStatus.textContent = msg || '';
    modalStatus.className = 'modal-status' + (kind ? ' ' + kind : '');
  };

  const openModal = () => {
    overlay.classList.add('open');
    setModalStatus('');
    pwInput.value = '';
    setTimeout(() => pwInput.focus(), 50);
  };
  const closeModal = () => overlay.classList.remove('open');

  overlay.addEventListener('mousedown', (e) => { if (e.target === overlay) closeModal(); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay.classList.contains('open')) closeModal();
  });
  $('modalClose').addEventListener('click', closeModal);

  const lockBtns = (on) => { btnPack.disabled = on; btnUnpack.disabled = on; };

  const setHash = (hash) => {
    try { history.replaceState(null, '', hash ? '#' + hash : location.pathname + location.search); } catch {}
  };

  const extractHash = (input) => {
    let s = String(input || '').trim();
    if (!s) return '';
    const i = s.indexOf('#');
    if (i >= 0) s = s.slice(i + 1);
    try { s = decodeURIComponent(s); } catch {}
    return s;
  };

  const doPack = async () => {
    const text = editor.value;
    const pw = pwInput.value;
    const t = i18n[isEN ? 'en' : 'ru'];
    if (!text) { setModalStatus(t.errEmpty, 'err'); return; }
    if (pw.length !== 10) { setModalStatus(t.errLen, 'err'); return; }
    lockBtns(true);
    setModalStatus('…');
    try {
      const hash = await ep(text, pw);
      if (!hash) { setModalStatus(t.errError, 'err'); return; }
      if (hash.length > HASH_LIMIT) {
        setModalStatus(t.errLong, 'err');
        return;
      }
      editor.value = hash;
      setHash(hash);
      grow();
      closeModal();
    } catch { setModalStatus(t.errError, 'err'); }
    finally { lockBtns(false); }
  };

  const doUnpack = async () => {
    const raw = extractHash(editor.value);
    const pw = pwInput.value;
    const t = i18n[isEN ? 'en' : 'ru'];
    if (!raw) { setModalStatus(t.errEmpty, 'err'); return; }
    if (pw.length !== 10) { setModalStatus(t.errLen, 'err'); return; }
    lockBtns(true);
    setModalStatus('…');
    try {
      const text = await dp(raw, pw);
      if (text === null || text === '') {
        setModalStatus(t.errFail, 'err');
        return;
      }
      editor.value = text;
      setHash('');
      grow();
      closeModal();
    } catch { setModalStatus(t.errError, 'err'); }
    finally { lockBtns(false); }
  };

  btnPack.addEventListener('click', doPack);
  btnUnpack.addEventListener('click', doUnpack);
  pwInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') { e.preventDefault(); doPack(); }
  });

  $('go').addEventListener('click', openModal);

  if (location.hash && location.hash.length > 1) {
    const fromHash = extractHash(location.hash);
    if (fromHash) { editor.value = fromHash; setHash(fromHash); grow(); }
  }

  applyLang('ru');
})();
</script>
</body>
</html>
